[Unit]
Description=Pixel Brightness V2 Web Control
After=network-online.target pixel-brightness-server.service
Wants=network-online.target

[Service]
Type=simple
User=pixelbrightness
Group=pixelbrightness
WorkingDirectory=/opt/pixel-brightness/current
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production
Environment=WRANGLER_LOG_PATH=/var/log/pixel-brightness/wrangler.log
ExecStart=/usr/bin/npm --prefix /opt/pixel-brightness/current run start
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pixel-brightness /var/log/pixel-brightness
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
