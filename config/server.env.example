PB_SERVER_HOST=0.0.0.0
PB_SERVER_PORT=4100
# Browser page port, separate from the API port. Preview launcher uses 3001.
PB_WEB_CONTROL_PORT=3000
PB_SERVER_DATA_DIR=/var/lib/pixel-brightness/server
PB_MAX_UPLOAD_BYTES=21474836480
# The control token and Node-signing key must be different protected secrets.
PB_CONTROL_TOKEN_FILE=/etc/pixel-brightness/control-token
PB_NODE_SIGNING_KEY_FILE=/etc/pixel-brightness/node-signing-key
# Panasonic PT-VMZ51 native LAN Command Control (TCP, default port 1024).
PB_PROJECTOR_CONTROL_USERNAME=dispadmin
PB_PROJECTOR_CONTROL_PASSWORD_FILE=/etc/pixel-brightness/panasonic-projector-password
PB_PROJECTOR_COMMAND_TIMEOUT_MS=3000
PB_PROJECTOR_COMMAND_GAP_MS=500
# Windows-only experimental UVC geometry acquisition, disabled by default.
# Produces a candidate only; does not apply warp/blend or restore NDI routing.
PB_UVC_GEOMETRY_ENABLED=0
# PB_UVC_CAMERA_COMMAND=C:\path\to\pixel-brightness-uvc.exe
# PB_NDI_PATTERN_COMMAND=C:\path\to\pixel-brightness-ndi-patterns.exe
# PB_NDI_RUNTIME_DIRECTORY=C:\Program Files\NDI\NDI 6 SDK\Bin\x64
# Optional corrected NDI video preview, not production Auto certification.
PB_NDI_VIDEO_ENABLED=0
# PB_NDI_VIDEO_COMMAND=C:\path\to\pixel-brightness-ndi-video.exe
# PB_NDI_PROBE_COMMAND=C:\path\to\pixel-brightness-ndi-probe.exe
# PB_NDI_SHADER_DIRECTORY=C:\path\to\native\windows\shaders
# Build Web Control for a separate preview API port (default 4100).
# PB_WEB_API_PORT=4101
