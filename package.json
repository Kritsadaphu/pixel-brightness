{
  "name": "pixel-brightness-control",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "server": "node runtime/server/index.mjs",
    "render-node": "node runtime/node/index.mjs",
    "demo": "node runtime/demo.mjs",
    "test": "node scripts/run-vinext.mjs build && node --test --test-concurrency=4 tests/*.test.mjs",
    "test:unit": "node --test tests/calibration.test.mjs tests/mapping.test.mjs tests/protocol.test.mjs tests/timecore.test.mjs tests/panasonic-ntcontrol.test.mjs tests/projector-control.test.mjs tests/show-schedule.test.mjs",
    "test:server": "node --test tests/server.integration.test.mjs",
    "test:cluster": "node --test tests/distributed.integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "types:worker": "wrangler types worker/runtime-env.d.ts --config worker/types.wrangler.jsonc",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
